meta {
  name: Tasks - POST /api/tasks missing title
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: none
}

body:json {
  {
    "completed": false
  }
}

tests {
  test("status should be 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error message should match", function() {
    const body = res.getBody();
    expect(body.message).to.equal("title is required");
  });
}