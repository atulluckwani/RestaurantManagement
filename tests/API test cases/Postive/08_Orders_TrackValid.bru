meta {
  name: Orders - GET /api/orders/:orderId valid
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: none
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response should match requested order id", function() {
    const body = res.getBody();
    expect(body.orderId).to.equal(bru.getVar("orderId"));
  });
}